<ResourceDictionary xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ForegroundColor">#F2F2F2</Color>
  <Color x:Key="BackgroundColor">#1F1F1F</Color>
  <Color x:Key="BorderColor">#3C3C3C</Color>
  <Color x:Key="GridLinesColor">#2F2F2F</Color>
  <Color x:Key="HighlightedBorderColor">#5A5A5A</Color>
  <Color x:Key="FocusedBorderColor">#4C8FE0</Color>
  <Color x:Key="DisabledBorderColor">#5A5A5A</Color>

  <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource ForegroundColor}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="GridLinesBrush" Color="{DynamicResource GridLinesColor}" />
  <SolidColorBrush x:Key="HighlightedBorderBrush" Color="{DynamicResource HighlightedBorderColor}" />
  <SolidColorBrush x:Key="FocusedBorderBrush" Color="{DynamicResource FocusedBorderColor}" />
  <SolidColorBrush x:Key="DisabledBorderBrush" Color="{DynamicResource DisabledBorderColor}" />
</ResourceDictionary>
