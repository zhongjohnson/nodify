<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Activates the minimal WPF->Avalonia guards inside linked upstream sources. -->
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The upstream Nodify sources ship their own doc comments; suppress the noise while porting. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1734</NoWarn>
    <!--
      The linked upstream sources were written against WPF's non-nullable APIs
      (VisualTreeHelper.GetParent, DependencyObject.GetValue, ...). The Avalonia compat shims are
      nullable-annotated, so verbatim upstream code trips CS8600 (null->non-nullable) and CS8605
      (unbox possibly-null). These are inherent to keeping the linked sources unmodified for easy
      re-sync and are safe here (the shims never return null in these call sites), so they are suppressed.
    -->
    <NoWarn>$(NoWarn);CS8600;CS8605</NoWarn>

    <!-- Package metadata (mirrors Nodify, retargeted to Avalonia). -->
    <PackageId>Nodify.Avalonia</PackageId>
    <Product>Nodify.Avalonia</Product>
    <Description>The core controls for a node based editor (designed for MVVM) - Avalonia port that shares the upstream Nodify sources via a WPF compatibility shim.</Description>
    <Authors>miroiu</Authors>
    <Copyright>Miroiu Emanuel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/miroiu/nodify</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroiu/nodify</RepositoryUrl>
    <PackageTags>avalonia mvvm node network node-editor graph controls</PackageTags>
    <Version>7.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
  </ItemGroup>

  <!-- Option A source-fork port. See PORTING.md for strategy, subsystem checklist and status. -->

  <!--
    Phase 3b: link the CONTROL-INDEPENDENT interactivity primitives directly from the upstream
    Nodify sources so they stay in sync on future merges. These compile purely against the WPF
    compatibility shim under Compatibility\Wpf.

    DEFERRED to the control phase (do NOT link yet, they reference concrete controls / device APIs):
      Interactivity\InputProcessor.Shared.cs         (hard-refs NodifyEditor/ItemContainer/Connector/Minimap/BaseConnection)
      Interactivity\DragState.cs                     (Mouse/Stylus devices, Element context menu)
      Interactivity\InputElementStateStack.DragState.cs (NodifyEditor.ViewportUpdatedEvent, Mouse/Stylus)
      Interactivity\KeyboardNavigation\*             (navigator layers tied to controls)
      Utilities\EditorGesturesExtensions.cs          (needs SelectionType declared on NodifyEditor)
  -->
  <ItemGroup Label="Nodify.Interactivity (control-independent core)">
    <Compile Include="..\Nodify\Interactivity\IInputHandler.cs" Link="Interactivity\IInputHandler.cs" />
    <Compile Include="..\Nodify\Interactivity\InputProcessor.cs" Link="Interactivity\InputProcessor.cs" />
    <Compile Include="..\Nodify\Interactivity\InputElementState.cs" Link="Interactivity\InputElementState.cs" />
    <Compile Include="..\Nodify\Interactivity\InputElementStateStack.cs" Link="Interactivity\InputElementStateStack.cs" />
    <Compile Include="..\Nodify\Interactivity\InputElementStateStack.InputElementState.cs" Link="Interactivity\InputElementStateStack.InputElementState.cs" />
  </ItemGroup>

  <ItemGroup Label="Nodify.Interactivity (gestures)">
    <Compile Include="..\Nodify\Interactivity\Gestures\AllGestures.cs" Link="Interactivity\Gestures\AllGestures.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\AnyGesture.cs" Link="Interactivity\Gestures\AnyGesture.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\MultiGesture.cs" Link="Interactivity\Gestures\MultiGesture.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\InputGestureRef.cs" Link="Interactivity\Gestures\InputGestureRef.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\KeyComboGesture.cs" Link="Interactivity\Gestures\KeyComboGesture.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\MouseGesture.cs" Link="Interactivity\Gestures\MouseGesture.cs" />
    <Compile Include="..\Nodify\Interactivity\Gestures\EditorGestures.cs" Link="Interactivity\Gestures\EditorGestures.cs" />
  </ItemGroup>

  <!--
    Phase 4a: link the CONTROL-INDEPENDENT utility helpers from the upstream Nodify sources.
    These compile against the WPF compatibility shim (VisualTreeHelper hit testing, the animation
    slice, and the Rect.IntersectsWith alias) under Compatibility\Wpf.

    NOT linked (adapted/copied instead or deferred):
      Utilities\UnscaleTransformConverter.cs  (copied to Utilities\ - uses WPF Transform.Inverse; adapted to Matrix.TryInvert)
      Utilities\SelectionHelper.cs            (DEFERRED - control-coupled: references ItemContainer / SelectionType)
  -->
  <ItemGroup Label="Nodify.Utilities (control-independent)">
    <Compile Include="..\Nodify\Utilities\DependencyObjectExtensions.cs" Link="Utilities\DependencyObjectExtensions.cs" />
  </ItemGroup>

  <!--
    Phase 4b: Shapes & rendering. The reusable WPF-shaped rendering surface is provided as compat
    shims under Compatibility\Wpf (globbed automatically, no <Compile> link needed):
      Compatibility\Wpf\StreamGeometry.cs  (System.Windows.Media.StreamGeometry/StreamGeometryContext + FillRule/SweepDirection over Avalonia)
      Compatibility\Wpf\Shape.cs           (System.Windows.Shapes.Shape over Avalonia.Controls.Shapes.Shape; OnRender <-> Render)
      GlobalUsings.cs                       (DrawingContext = Avalonia.Media.DrawingContext alias)

    No upstream shape .cs files are linked yet. Every Nodify shape turned out to be control-coupled,
    so they are DEFERRED to the control/adorner phase to preserve bottom-up order:
      Connections\BaseConnection.cs         (IKeyboardFocusTarget<FrameworkElement>, InputProcessor.AddSharedHandlers,
                                             ConnectionContainer, AdornerLayer/FocusVisualAdorner, Geometry.Combine/
                                             GetWidenedPathGeometry/GetOutlinedPathGeometry, FormattedText)
      Connections\Connection.cs, LineConnection.cs, CircuitConnection.cs, StepConnection.cs  (derive from BaseConnection)
      CuttingLine\CuttingLine.cs            (IsOverElementProperty = PendingConnection.IsOverElementProperty.AddOwner(...),
                                             i.e. depends on the deferred PendingConnection connector control)

    The Pen/Brush/FormattedText draw shims and DrawingContext.DrawRoundedRectangle helper are only
    needed by the above deferred code and are therefore also deferred to the control/adorner phase.
  -->

  <!--
    Phase 5: Adorners. The reusable WPF Adorner/AdornerLayer surface is provided as a compat shim
    under Compatibility\Wpf (globbed automatically, no <Compile> link needed):
      Compatibility\Wpf\Adorner.cs  (System.Windows.Documents.Adorner over Avalonia Control with the
                                     OnRender<->Render bridge + WPF value accessors + AddVisual/LogicalChild +
                                     TryFindResource + IsClipEnabled; and a System.Windows.Documents.AdornerLayer
                                     fa?ade over Avalonia.Controls.Primitives.AdornerLayer exposing WPF
                                     GetAdornerLayer/Add/Remove/Update).

    The actual adorners stay DEFERRED to the control phase — they are private nested classes of
    deferred controls and additionally need Pen / WPF geometry ops / HotKeyControl / Connector.Thumb:
      Connections\BaseConnection.cs   -> nested FocusVisualAdorner (Pen, Geometry.Combine/GetWidened/GetOutlined)
      Connectors\PendingConnection.cs -> nested HotKeyAdorner (hosts HotKeyControl, Connector.Thumb.TranslatePoint)
      Connectors\HotKeyControl.cs     (standalone Control, but uses DefaultStyleKey/template -> control phase)
  -->

  <!--
    Phase 6a: Foundational containers/nodes (logic-first; themes deferred to Phase 9).
    The reusable WPF control bases are provided as compat shims under Compatibility\Wpf
    (globbed automatically, no <Compile> link needed):
      Compatibility\Wpf\Controls.cs  (System.Windows.Controls.ContentControl/HeaderedContentControl over
                                      Avalonia, exposing DefaultStyleKeyProperty [record-only; theming
                                      deferred] + FocusableProperty [wraps Avalonia InputElement.Focusable]
                                      + WPF value accessors + OnPropertyChanged coercion/change routing).

    Phase 6b adds the reusable templating/styling/presenter primitives (also globbed):
      GlobalUsings.cs                (DataTemplate/ControlTemplate/Style aliases -> Avalonia interfaces/Style)
      Compatibility\Wpf\Controls.cs  (also System.Windows.Controls.ContentPresenter/Border shims exposing
                                      Content/ContentTemplate/CornerRadius DP statics via DependencyProperty.FromExisting
                                      so upstream AddOwner(...) works)

    Least-coupled control ported first, linked verbatim from upstream so it stays in sync:
      Nodes\KnotNode.cs  (ContentControl + DefaultStyleKeyProperty/FocusableProperty overrides only)
  -->
  <ItemGroup Label="Nodify.Nodes (foundational, control-independent)">
    <Compile Include="..\Nodify\Nodes\KnotNode.cs" Link="Nodes\KnotNode.cs" />
    <Compile Include="..\Nodify\Nodes\Node.cs" Link="Nodes\Node.cs" />
  </ItemGroup>

  <!--
    Phase 6c: Panel primitive + first panel control. Reusable shim (globbed automatically):
      Compatibility\Wpf\Panel.cs   (System.Windows.Controls.Panel over Avalonia Panel: InternalChildren,
                                    Panel.ZIndex GetZIndex/SetZIndex + ZIndexProperty via FromExisting,
                                    WPF value accessors + OnPropertyChanged routing)
      GlobalUsings.cs              (UIElementCollection -> Avalonia.Controls.Controls alias)

    NodifyCanvas is COPIED & ADAPTED (not linked) into Editor\NodifyCanvas.cs and auto-globbed. The
    only change vs. upstream is children[i].RenderSize -> children[i].Bounds.Size (Avalonia Control has
    no WPF RenderSize); isolated behind // PORT: comments. It carries the INodifyCanvasItem interface,
    which is declared in the same upstream file.
  -->

  <!--
    Phase 6d: Node (input/output connector host). Reusable shims (globbed automatically):
      Compatibility\Wpf\Controls.cs             (HeaderedContentControl now bridges WPF templating:
                                                parameterless OnApplyTemplate() + GetTemplateChild(name), mapped from
                                                Avalonia's OnApplyTemplate(TemplateAppliedEventArgs) via the applied INameScope)
      Compatibility\Wpf\ItemsControl.cs         (System.Windows.Controls.ItemsControl over Avalonia ItemsControl +
                                                GroupStyle carrier; grouping behavior deferred to theme phase)
      Compatibility\Wpf\AuthoringAttributes.cs  (inert [TemplatePart]/[StyleTypedProperty] attributes; metadata only)
      GlobalUsings.cs                           (Brush -> Avalonia.Media.IBrush)

    Node is linked verbatim from upstream (in the Nodify.Nodes ItemGroup above).
  -->

  <!--
    Phase 7a: Editor-core primitive shims (prep for the ItemContainer/NodifyEditor/Connector cluster,
    whose controls are mutually coupled and must land together in a later phase). Reusable shims
    (globbed automatically):
      Compatibility\Wpf\SelectorAndStackPanel.cs  (System.Windows.Controls.Primitives.Selector.IsSelectedProperty
                                                  over Avalonia SelectingItemsControl.IsSelected; and
                                                  System.Windows.Controls.StackPanel.OrientationProperty over
                                                  Avalonia StackPanel.Orientation - both via FromExisting for AddOwner)
      Compatibility\Wpf\Controls.cs               (HeaderedContentControl now also exposes Header/HeaderTemplate WPF
                                                  DP statics via FromExisting so NodeInput/NodeOutput AddOwner(...) works)
  -->

  <!--
    Phase 7b: FrameworkElement layout/input primitive surface (also prep for the editor-core cluster
    and the deferred DragState). Reusable shims (globbed automatically):
      Compatibility\Wpf\FrameworkElement.cs   (UIElement gains RenderSize [over Bounds.Size],
                                              OnRenderSizeChanged(SizeChangedInfo) wired from Avalonia SizeChanged,
                                              TranslatePoint/IsAncestorOf [over Avalonia.VisualTree], and pointer-capture
                                              IsMouseCaptured/CaptureMouse/ReleaseMouseCapture [over InputStateTracker.Pointer];
                                              new SizeChangedInfo type)
      Compatibility\Wpf\Input\InputState.cs   (Mouse.Captured over IPointer.Captured)
      GlobalUsings.cs                          (SizeChangedEventArgs -> Avalonia.Controls.SizeChangedEventArgs)
  -->

  <!--
    Phase 8: Editor-core cluster. These upstream controls are mutually coupled (InputProcessor.Shared
    references NodifyEditor/ItemContainer/Connector/Minimap/BaseConnection), so the whole remaining
    control surface + its interactivity state machine is linked together. Linked verbatim from
    upstream so they stay in sync; shim gaps are resolved in the Compatibility layer.
  -->
  <ItemGroup Label="Nodify.Interactivity (control-coupled handlers)">
    <Compile Include="..\Nodify\Interactivity\InputProcessor.Shared.cs" Link="Interactivity\InputProcessor.Shared.cs" />
    <Compile Include="..\Nodify\Interactivity\DragState.cs" Link="Interactivity\DragState.cs" />
