    <Compile Include="..\Nodify\Interactivity\KeyboardNavigation\LinearFocusNavigator.cs" Link="Interactivity\KeyboardNavigation\LinearFocusNavigator.cs" />
    <Compile Include="..\Nodify\Interactivity\KeyboardNavigation\StatefulFocusNavigator.cs" Link="Interactivity\KeyboardNavigation\StatefulFocusNavigator.cs" />
    <Compile Include="..\Nodify\Interactivity\KeyboardNavigation\DirectionalFocusNavigator.cs" Link="Interactivity\KeyboardNavigation\DirectionalFocusNavigator.cs" />
  </ItemGroup>

